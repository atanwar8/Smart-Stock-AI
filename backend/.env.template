# Copy to backend/.env (local) or set these in your cloud dashboard.

# USDA MyMarketNews API key — free at https://mymarketnews.ams.usda.gov (My Profile → API Key)
# Needed by Data refresh to pull new weekly retail prices.
MARS_API_KEY=your_mymarketnews_api_key_here

# Training store (Forecast Studio, pipeline). Unset = local SQLite at backend/var/smartstock.db.
# Use Supabase's Session pooler string (Project Settings -> Database -> Connection string -> Session pooler);
# Render has no IPv6, so the direct db.<ref>.supabase.co host won't connect from there.
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Server
API_HOST=localhost
API_PORT=8000
DEBUG=True

# Optional overrides (defaults point at the CSVs in the project root)
# DATA_DIR=/path/to/csv/folder
# ALLOWED_ORIGINS=http://localhost:3000

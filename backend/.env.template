# Copy to backend/.env (local) or set these in your cloud dashboard.

# OpenWeather API key — free at https://openweathermap.org/api
# Without it the app falls back to synthetic weather data.
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Server
API_HOST=localhost
API_PORT=8000
DEBUG=True

# Optional overrides (defaults point at the CSVs in the project root)
# DATA_DIR=/path/to/csv/folder
# ALLOWED_ORIGINS=http://localhost:3000
